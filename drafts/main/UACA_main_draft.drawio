        <mxCell id="0_oQn6sSV1q4ufeET9i9-58" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;autosize=1;resizable=0;" value="我们，是不是看看，这个图，怎么把，一些元素，按头图的，替换为，我们uaca的？" vertex="1">
          <mxGeometry height="30" width="470" x="200" y="-180" as="geometry" />
        </mxCell>
        <mxCell id="0_oQn6sSV1q4ufeET9i9-59" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;autosize=1;resizable=0;" value="首先是任务执行图；能找到，我们uaca，画头图的，那3张场景图的，对应的执行的，3相机视频吗？回忆下，找找；可以的话，选视频中5个时间给我，每个时间3相机各1张图，我选一组图；能明白我的意图吗？" vertex="1">
          <mxGeometry height="30" width="1140" x="-390" y="-90" as="geometry" />
        </mxCell>
        <mxCell id="0_oQn6sSV1q4ufeET9i9-61" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;autosize=1;resizable=0;" value="这几个图，文字，步数，等等元素，是不是，都看看，逐一换成，我们头图的？" vertex="1">
          <mxGeometry height="30" width="440" x="-470" y="572.5" as="geometry" />
        </mxCell>
        <mxCell id="0_oQn6sSV1q4ufeET9i9-62" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;autosize=1;resizable=0;" value="DV单词是不是换成熵？曲线，横轴，是不是也是，精准 替换？试试看；迭代的，检查，保持是精准替换；" vertex="1">
          <mxGeometry height="30" width="580" x="-580" y="780" as="geometry" />
        </mxCell>
        <mxCell id="0_oQn6sSV1q4ufeET9i9-63" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;autosize=1;resizable=0;" value="这个也是，同样的尝试精准的元素替换？" vertex="1">
          <mxGeometry height="30" width="240" x="-270" y="1700" as="geometry" />
        </mxCell>
        <mxCell id="0_oQn6sSV1q4ufeET9i9-64" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;autosize=1;resizable=0;" value="&lt;span style=&quot;color: rgba(0, 0, 0, 0); font-family: monospace; font-size: 0px; text-align: start; text-wrap-mode: nowrap;&quot;&gt;%3CmxGraphModel%3E%3Croot%3E%3CmxCell%20id%3D%220%22%2F%3E%3CmxCell%20id%3D%221%22%20parent%3D%220%22%2F%3E%3CmxCell%20id%3D%222%22%20parent%3D%221%22%20style%3D%22text%3Bhtml%3D1%3BwhiteSpace%3Dnowrap%3Boverflow%3Dvisible%3BfillColor%3Dnone%3BstrokeColor%3Dnone%3B%3BfontSize%3D50.3938564477%3Balign%3Dcenter%3BverticalAlign%3Dmiddle%3Bspacing%3D0%3BfontFamily%3DDVCAChalkboardUnion%3B%22%20value%3D%22Denoising%20Variance%22%20vertex%3D%221%22%3E%3CmxGeometry%20height%3D%2297.5364963504%22%20width%3D%22599.849452555%22%20x%3D%22471.863150547%22%20y%3D%221853.6945242309998%22%20as%3D%22geometry%22%2F%3E%3C%2FmxCell%3E%3C%2Froot%3E%3C%2FmxGraphModel%3E&lt;/span&gt;" vertex="1">
          <mxGeometry height="30" width="20" x="-800" y="1810" as="geometry" />
        </mxCell>
