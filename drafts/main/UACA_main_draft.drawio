          <mxGeometry height="60" width="60" x="3670" y="370" as="geometry" />
        </mxCell>
        <mxCell id="0_oQn6sSV1q4ufeET9i9-72" edge="1" parent="1" style="edgeStyle=none;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;" value="">
          <mxGeometry relative="1" width="100" as="geometry">
