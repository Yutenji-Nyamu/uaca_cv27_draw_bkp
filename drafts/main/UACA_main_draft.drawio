          </mxGeometry>
        </mxCell>
        <mxCell id="0_oQn6sSV1q4ufeET9i9-75" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;autosize=1;resizable=0;" value="由浅到深的不同颜色" vertex="1">
          <mxGeometry height="30" width="130" x="2830" y="400" as="geometry" />
        </mxCell>
        <mxCell id="0_oQn6sSV1q4ufeET9i9-76" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;autosize=1;resizable=0;" value="渐变色，和上面两个色有关？方向都差不多？渐变的有区别？" vertex="1">
          <mxGeometry height="30" width="350" x="2930" y="880" as="geometry" />
        </mxCell>
        <mxCell id="0_oQn6sSV1q4ufeET9i9-77" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;autosize=1;resizable=0;" value="我想尝试下替换方块的色系；能理解我的意图吗？尝试新画两三个图尝试下；图中有很多方块吧；对应的调整；要先理解，图中，方块颜色，和表达意思的关系，理解图中各个色间的关系，再对应的调整色系；总之，迭代的修，渲染，理解，逼近我的意图；" vertex="1">
          <mxGeometry height="30" width="1380" x="2830" y="100" as="geometry" />
        </mxCell>
        <mxCell id="0_oQn6sSV1q4ufeET9i9-78" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;autosize=1;resizable=0;" value="图中很多符号，是不是也要对应的调整？我们的uaca，相比dv，改的符号应该不多？讨论下；" vertex="1">
          <mxGeometry height="30" width="520" x="1910" y="2040" as="geometry" />
        </mxCell>
        <mxCell id="0_oQn6sSV1q4ufeET9i9-80" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;autosize=1;resizable=0;" value="有改字体的，要记得，对齐原来的vgpo字体" vertex="1">
          <mxGeometry height="30" width="250" x="955" y="2030" as="geometry" />
        </mxCell>
      </root>
